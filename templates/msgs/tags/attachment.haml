.attachment.mb-2
  -if category == 'image'

    -if thumb
      .thumb
        %img.cursor-pointer.rounded-lg(src="{{thumb}}" style='height:50px;width:auto;' onclick='showLightbox(event, "{{url|escapejs}}")')

    -else
      .attachment-preview.button-light.rounded-r-none(class="{% if thumb %}thumb{% endif %}" onclick="showPreview(event, this)" data-preview-type="image" data-preview-url="{{url}}")
        %temba-icon.mr-1(name="attachment_image")
        {{preview}}

  -elif category == 'audio' and is_playable
    %a.attachment-preview.button-light.rounded-r-none(onclick="showPreview(event, this)" data-preview-type="audio" data-preview-url="{{url}}" data-content-type="{{content_type}}")
      %temba-icon.mr-1(name="attachment_audio")
      {{preview}}

  -elif category == 'video' and is_playable
    %a.attachment-preview.button-light.rounded-r-none(onclick="showPreview(event, this)" data-preview-type="video" data-preview-url="{{url}}" data-content-type="{{content_type}}")
      %temba-icon.mr-1(name="attachment_video")
      {{preview}}

  -elif category == 'geo'
    .attachment-preview.button-light(onclick='openWindow(event, "{{url|escapejs}}", "_loc")')
      %temba-icon.mr-1(name="attachment_location")
      {{preview}}

  -else
    .attachment-preview.button-light.rounded-r-none(onclick="showPreview(event, this)" data-preview-type="pdf" data-preview-url="{{url}}")
      %temba-icon.mr-1(name="attachment_document")
      {{preview}}

  -if category != 'geo' and not thumb
    %div
      .flex-grow.attachment-download.rounded-l-none.button-light(onclick="goto(event, this)" href="{{url}}" download="true")
        %temba-icon(name="download" onclick='downloadFile(event, "{{url|escapejs}}")')